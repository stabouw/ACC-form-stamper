{
  "manifest_version": 3,
  "name": "ACC Form Stamper",
  "version": "0.1.0",
  "description": "Zet de gekoppelde assets van een ACC-formulier in het notitieveld, zodat je in Forma Build op assetnaam en categorie kunt filteren.",

  "key": "",

  "permissions": ["identity", "storage"],

  "host_permissions": [
    "https://developer.api.autodesk.com/*",
    "https://acc.autodesk.com/*",
    "https://acc.autodesk.eu/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "ACC Form Stamper"
  }
}
